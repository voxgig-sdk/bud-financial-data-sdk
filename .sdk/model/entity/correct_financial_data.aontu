# Entity: correct_financial_data

main: kit: entity: correct_financial_data: {

  alias: field: {}

  fields: {
    created_at: {
      h: "Created At"
      n: "created_at"
      r: true
      sh: "Date that the custom merchant was created, compliant with RFC3339."
      t: "`$STRING`"
    }
    custom_merchant_id: {
      fo: "uuid"
      h: "Custom Merchant Id"
      n: "custom_merchant_id"
      r: true
      sh: "UUID representing the custom merchant."
      t: "`$STRING`"
    }
    data: {
      h: "Data"
      n: "data"
      r: true
      sh: "List of merchant that matched the query."
      t: "`$ARRAY`"
    }
    frequency: {
      h: "Frequency"
      n: "frequency"
      r: true
      sh: "The frequency to assign."
      t: "`$STRING`"
    }
    include_similar: {
      h: "Include Similar"
      n: "include_similar"
      r: false
      sh: "Apply the correction to the whole group of transactions similar to the specified transaction, rather than just the transaction itself"
      t: "`$BOOLEAN`"
    }
    logo_feedback: {
      h: "Logo Feedback"
      n: "logo_feedback"
      r: true
      sh: "The type of feedback for the merchant."
      t: "`$STRING`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: true
      sh: "Metadata associated with the response schema"
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The display name of the custom merchant to be created"
      t: "`$STRING`"
    }
    online_or_billing_only: {
      h: "Online Or Billing Only"
      n: "online_or_billing_only"
      op: {
        list: {
          req: true
          type: "`$BOOLEAN`"
        }
      }
      r: false
      sh: "This is used to indicate if the custom merchant being created is an exclusively online or billing merchant."
      t: "`$BOOLEAN`"
    }
    operation_id: {
      h: "Operation Id"
      n: "operation_id"
      r: true
      sh: "A unique identifier/reference associated with a given endpoint/operation"
      t: "`$STRING`"
    }
    reference_transaction_id: {
      h: "Reference Transaction Id"
      n: "reference_transaction_id"
      r: false
      sh: "The transaction whose group the specified transactions should join or leave."
      t: "`$STRING`"
    }
    rule_definition: {
      h: "Rule Definition"
      n: "rule_definition"
      r: true
      sh: "The definition of the rule, mirroring the request body that created it."
      t: "`$OBJECT`"
    }
    rule_type: {
      h: "Rule Type"
      n: "rule_type"
      r: true
      sh: "The type of correction rule"
      t: "`$STRING`"
    }
    similar: {
      h: "Similar"
      n: "similar"
      r: false
      sh: "Whether the specified transactions are similar to each other (or to `reference_transaction_id`, if supplied)"
      t: "`$BOOLEAN`"
    }
    suggested_logo: {
      h: "Suggested Logo"
      n: "suggested_logo"
      r: false
      t: "`$STRING`"
    }
    suggested_url: {
      h: "Suggested Url"
      n: "suggested_url"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "A suggested URL for the merchant, to help bud identify it and expand our merchant database."
      t: "`$STRING`"
    }
    transaction_id: {
      h: "Transaction Id"
      n: "transaction_id"
      r: true
      sh: "The unique identifier for the transaction"
      t: "`$STRING`"
    }
    transaction_ids: {
      h: "Transaction Ids"
      n: "transaction_ids"
      r: true
      sh: "The transactions the rule applies to"
      t: "`$ARRAY`"
    }
  }

