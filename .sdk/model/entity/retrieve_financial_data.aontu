# Entity: retrieve_financial_data

main: kit: entity: retrieve_financial_data: {

  alias: field: {}

  fields: {
    account_category: {
      h: "Account Category"
      n: "account_category"
      r: false
      sh: "The account category that the account type is a part of Currently supported values include (but are not necessarily limited to): - `credit` - `depository` - `insurance` - `investment` - `loan` - `savings` - `other`"
      t: "`$STRING`"
    }
    account_id: {
      h: "Account Id"
      n: "account_id"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "A unique id associated with the account."
      t: "`$STRING`"
    }
    account_name: {
      h: "Account Name"
      n: "account_name"
      r: false
      sh: "The name associated with the account, this is often a friendly name assigned to the account to make it easier to refer to."
      t: "`$STRING`"
    }
    account_type: {
      h: "Account Type"
      n: "account_type"
      r: false
      sh: "The type of account."
      t: "`$STRING`"
    }
    balances: {
      h: "Balances"
      n: "balances"
      op: {
        list: {
          req: true
          type: "`$ARRAY`"
        }
      }
      r: false
      sh: "The balances ingested for the account."
      t: "`$OBJECT`"
    }
    booked: {
      h: "Booked"
      n: "booked"
      r: true
      sh: "The current balance of the account"
      t: "`$ANY`"
    }
    closed_at: {
      fo: "date-time"
      h: "Closed At"
      n: "closed_at"
      r: false
      sh: "The datetime the account was closed in the format [RFC 3339](https://www.rfc-editor.org/rfc/rfc3339)."
      t: "`$STRING`"
    }
    credit_lines: {
      h: "Credit Lines"
      n: "credit_lines"
      r: false
      sh: "The latest credit limit available for the account."
      t: "`$OBJECT`"
    }
    currency: {
      h: "Currency"
      n: "currency"
      r: true
      sh: "The three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) of the monetary amount."
      t: "`$STRING`"
    }
    data: {
      h: "Data"
      n: "data"
      r: true
      t: "`$OBJECT`"
    }
    date: {
      h: "Date"
      n: "date"
      r: true
      sh: "The date of the given balance in the format [RFC 3339](https://www.rfc-editor.org/rfc/rfc3339)."
      t: "`$STRING`"
    }
    details: {
      h: "Details"
      n: "details"
      r: false
      sh: "Provides more details for the authorised payment."
      t: "`$ARRAY`"
    }
    first_transaction_date: {
      fo: "date-time"
      h: "First Transaction Date"
      n: "first_transaction_date"
      r: true
      sh: "The date of the first transaction that bud has stored for this account."
      t: "`$STRING`"
    }
    frequency: {
      h: "Frequency"
      n: "frequency"
      r: false
      sh: "The frequency of the authorised payment."
      t: "`$STRING`"
    }
    holder: {
      h: "Holder"
      n: "holder"
      r: false
      sh: "The account holder."
      t: "`$OBJECT`"
    }
    holders: {
      h: "Holders"
      n: "holders"
      r: false
      sh: "The account holder(s)."
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The id for the authorised payment."
      t: "`$STRING`"
    }
    identifiers: {
      h: "Identifiers"
      n: "identifiers"
      r: false
      sh: "These are wellknown fields which uniquely identify the account."
      t: "`$OBJECT`"
    }
    last_transaction_date: {
      fo: "date-time"
      h: "Last Transaction Date"
      n: "last_transaction_date"
      r: true
      sh: "The date of the last transaction that bud has stored for this account."
      t: "`$STRING`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: true
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the payment."
      t: "`$STRING`"
    }
    opening_date_time: {
      fo: "date-time"
      h: "Opening Date Time"
      n: "opening_date_time"
      r: false
      sh: "The datetime the account was opened in the format [RFC 3339]"
      t: "`$STRING`"
    }
    operation_id: {
      h: "Operation Id"
      n: "operation_id"
      r: true
      t: "`$STRING`"
    }
    pending: {
      h: "Pending"
      n: "pending"
      r: true
      sh: "The balance of the account if all pending transactions have settled."
      t: "`$ANY`"
    }
    provider: {
      h: "Provider"
      n: "provider"
      r: false
      sh: "The account's provider, this is usually the bank or building society the account is held with."
      t: "`$STRING`"
    }
    provider_display_name: {
      h: "Provider Display Name"
      n: "provider_display_name"
      r: false
      sh: "The display name for the account's provider."
      t: "`$STRING`"
    }
    provider_logo: {
      h: "Provider Logo"
      n: "provider_logo"
      r: false
      sh: "A link to an image for the accounts provider's logo."
      t: "`$STRING`"
    }
    reference: {
      h: "Reference"
      n: "reference"
      r: true
      sh: "The reference associated with the authorised payment."
      t: "`$STRING`"
    }
    restriction: {
      h: "Restriction"
      n: "restriction"
      r: false
      sh: "The restriction on the account, if any."
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The status of the account."
      t: "`$STRING`"
    }
    suggested_name: {
      h: "Suggested Name"
      n: "suggested_name"
      r: true
      sh: "The name Bud suggests client apps show for the account."
      t: "`$STRING`"
    }
    transaction_windows: {
      h: "Transaction Windows"
      n: "transaction_windows"
      r: false
      sh: "The transaction windows indicate for which periods we have full coverage of transactions ingested for the account."
      t: "`$ARRAY`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "The type of the authorised payment."
      t: "`$STRING`"
    }
    usage_type: {
      h: "Usage Type"
      n: "usage_type"
      r: false
      sh: "The intended usage of the account."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
